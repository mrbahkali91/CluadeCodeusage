# Copy to .env for `docker compose`, or export these for a native run.
# NOTHING IN THIS FILE IS A REAL SECRET. Do not commit a filled-in .env.

# --- Database -------------------------------------------------------------
# PostgreSQL 16 + PostGIS 3.4 + pg_trgm.
SREOI_DATABASE_URL=postgresql+psycopg://sreoi:sreoi@127.0.0.1:5432/sreoi

# Optional: point the test suite at a separate database. It otherwise derives
# a sibling `<name>_test` so a test run cannot destroy your development data.
# SREOI_TEST_DATABASE_URL=postgresql+psycopg://sreoi:sreoi@127.0.0.1:5432/sreoi_test

# Passwords for the Docker stack. The `postgres` role is the cluster superuser;
# `sreoi` is the application role and is created NOSUPERUSER NOBYPASSRLS, because
# a superuser is exempt from row-level security and would defeat tenant isolation.
POSTGRES_PASSWORD=postgres
SREOI_DB_PASSWORD=sreoi

# --- Authentication -------------------------------------------------------
# Production: point at your identity provider and leave SREOI_AUTH_DEV_MODE unset.
# SREOI_OIDC_ISSUER=https://your-idp.example.com/
# SREOI_OIDC_AUDIENCE=sreoi
# SREOI_OIDC_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json

# Local development only: a password issuer, with no identity provider. The
# application REFUSES TO START if this is set alongside a configured OIDC
# issuer. The secret signs HS256 tokens and must be at least 32 bytes.
SREOI_AUTH_DEV_MODE=1
SREOI_DEV_TOKEN_SECRET=change-me-a-local-development-secret-32b+

# The organisation and first user created on startup. Leave the password empty
# to have one generated and printed once.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# --- Misc -----------------------------------------------------------------
# 0=silent 1=warn 2=log 3=info 4=debug 5=trace
LOG_LEVEL=2

# Turns a missing test database into a hard failure instead of 209 silent
# skips. `make check` sets this; set it in CI too.
# SREOI_REQUIRE_DB=1

# --- Saudi Open Data portal (assumption A-01) -----------------------------
# The connector discovers the API shape rather than assuming one, so on a
# network that can reach the portal the dataset id is usually all you need:
#
#   export SREOI_OPENDATA_DATASET=c4eb90eb-de47-4996-9eba-8ae503980bcf
#   python -m sreoi_pipeline.cli opendata --dry-run --limit 5
#
# --dry-run needs no database. It fetches one page, prints the columns it
# found and the mapping it inferred, and stops. Only run the real ingest once
# that mapping reads correctly.
# SREOI_OPENDATA_DATASET=
# SREOI_OPENDATA_BASE_URL=https://open.data.gov.sa

# Set only if the portal issues you one. It is a credential: keep it out of
# git and out of logs.
# SREOI_OPENDATA_API_KEY=
# SREOI_OPENDATA_API_KEY_HEADER=api_key
# Send the key as a query parameter instead of a header, if the portal wants that:
# SREOI_OPENDATA_API_KEY_PARAM=api_key

# Set only if path discovery fails. The error message lists every path tried
# with its exact failure, so copy the one your browser's network tab shows.
# {dataset} is substituted.
# SREOI_OPENDATA_PATH=/api/v1/datasets/{dataset}/records
# SREOI_OPENDATA_PAGE_STYLE=offset   # or `page`
# SREOI_OPENDATA_PAGE_SIZE=100

# Field mapping. Leave these unset first: the connector matches column names
# (Arabic and English) itself and REFUSES to run rather than guess when it
# cannot. Set them only when it asks you to -- the error names the exact
# variable and lists every column it observed. Mapping the wrong column into
# `price` would produce confident, wrong valuations, which is why there is no
# silent fallback.
# SREOI_OPENDATA_FIELD_PRICE=
# SREOI_OPENDATA_FIELD_AREA=
# SREOI_OPENDATA_FIELD_DATE=
# SREOI_OPENDATA_FIELD_PROPERTY_TYPE=
# SREOI_OPENDATA_FIELD_DISTRICT=
# SREOI_OPENDATA_FIELD_CITY=
# SREOI_OPENDATA_FIELD_LAT=
# SREOI_OPENDATA_FIELD_LON=
# SREOI_OPENDATA_FIELD_ID=

# Copy to deploy/origin/.env and fill in. THIS FILE'S REAL COUNTERPART HOLDS
# SECRETS: .env is gitignored, keep it that way, and never paste a tunnel token
# or a password into an issue, a PR or a chat message.

# --- Database -------------------------------------------------------------
# Generate both with: openssl rand -base64 32
POSTGRES_PASSWORD=
SREOI_DB_PASSWORD=

# --- Public identity ------------------------------------------------------
# The origin the browser uses. Used for CORS; the proxy makes same-origin the
# normal case, so this is a backstop rather than the main path.
PUBLIC_ORIGIN=https://bahkali-tek.com

# --- Cloudflare Tunnel ----------------------------------------------------
# Zero Trust -> Networks -> Tunnels -> Create a tunnel -> Docker. Copy the
# token from the command it shows. Route its public hostname to
# http://api:3000. This token is a credential: rotate it if it ever leaks.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Authentication -------------------------------------------------------
# Choose ONE. The application refuses to start with both.
#
# (a) An identity provider. What this should be for anything real.
# SREOI_OIDC_ISSUER=https://your-idp.example.com/
# SREOI_OIDC_AUDIENCE=sreoi
# SREOI_OIDC_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
#
# (b) The development password issuer. Acceptable ONLY behind Cloudflare
#     Access, which authenticates every visitor before a request reaches this
#     server at all. The secret must be at least 32 bytes:
#     openssl rand -base64 48
# SREOI_AUTH_DEV_MODE=1
# SREOI_DEV_TOKEN_SECRET=

# The first user. Leave the password empty to have one generated and printed
# once in the engine's startup log.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 0=silent 1=warn 2=log 3=info 4=debug 5=trace
LOG_LEVEL=2
